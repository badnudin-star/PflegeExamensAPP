<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude these legacy preferences from both transport types. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pflege_examen_prefs.xml" />
        <exclude domain="sharedpref" path="pflege_examen_ranking_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pflege_examen_prefs.xml" />
        <exclude domain="sharedpref" path="pflege_examen_ranking_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
