name: Deploy PflegeExamen Ranking Worker (0 EUR Free Tier)

on:
  workflow_dispatch:
  push:
    branches: ["main"]
    paths:
      - "cloudflare-ranking/**"

jobs:
  deploy:
    runs-on: ubuntu-latest
    if: ${{ vars.ENABLE_CLOUDFLARE_DEPLOY == 'true' }}
    steps:
      - uses: actions/checkout@v4
      - uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          workingDirectory: "cloudflare-ranking"
